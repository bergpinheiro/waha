{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "plugins": ["@nestjs/swagger"],
    "watchPathIgnorePatterns": ["node_modules", "src/dashboard", "dist"],
    "assets": [
      { "include": "dashboard/**", "watchAssets": false },
      { "include": "core/engines/webjs/*", "watchAssets": true },
      { "include": "plus/engines/webjs/*", "watchAssets": true },
      { "include": "apps/chatwoot/i18n/locales/*.yaml", "watchAssets": true },
      { "include": "apps/chatwoot/i18n/locales/*.yml", "watchAssets": true }
    ],
    "watchAssets": false
  }
}
